# --- macOS / editor cruft ----------------------------------------------------
.DS_Store
._*

# --- Local tooling config (machine-specific, not part of the analysis) --------
.claude/

# --- R session state ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user
# RStudio project files -- not needed to run the analysis
*.Rproj

# --- Generated outputs -------------------------------------------------------
# Everything under Outputs/ is regenerated by run_full_analysis.R. Tracking it
# would bloat the repo and invite the results on disk to drift from the code.
# The provenance records under _provenance/ are NOT tracked either: they
# describe one run on one machine. run_full_analysis.R creates that folder on
# first run, so a fresh clone needs nothing there. To publish a specific run's
# provenance, or a supplementary table, un-ignore that file below.
Outputs/*
!Outputs/README.md

# --- Large / third-party inputs ----------------------------------------------
# Not tracked (too large or from another publication). raw_counts.csv IS tracked.
# See REPRODUCIBILITY.md for where to obtain each of these.
Input files/*.gmt
Input files/*.rds
Input files/cross_species/*.xlsx

# --- renv --------------------------------------------------------------------
# renv.lock IS tracked -- it is what pins package versions for everyone else.
# The library itself is not: renv writes its own renv/.gitignore (which IS
# tracked) covering library/, local/, cellar/, lock/, python/, sandbox/ and
# staging/, so nothing more is needed here.

