# --- macOS / editor cruft ----------------------------------------------------
.DS_Store
._*

# --- Local tooling config (machine-specific, not part of the analysis) --------
.claude/

# --- R session state ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user
# RStudio project files -- not needed to run the analysis
*.Rproj

# --- Generated outputs -------------------------------------------------------
# Everything under Outputs/ is regenerated by run_full_analysis.R. Tracking it
# would bloat the repo and invite the results on disk to drift from the code.
# The provenance records are kept, since they document what a given run did.
Outputs/*
!Outputs/README.md
!Outputs/_provenance/
Outputs/_provenance/*
!Outputs/_provenance/.gitkeep

# --- Large / third-party inputs ----------------------------------------------
# Not tracked (too large or from another publication). raw_counts.csv IS tracked.
# See REPRODUCIBILITY.md for where to obtain each of these.
Input files/*.gmt
Input files/*.rds
Input files/cross_species/*.xlsx

# --- renv --------------------------------------------------------------------
# renv.lock IS tracked -- it is what pins package versions for everyone else.
# The library itself is not.
renv/library/
renv/local/
renv/staging/
renv/python/
renv/sandbox/

# --- Node ---------------------------------------------------------------------
# The reports/ build scripts need the `docx` package.
node_modules/
package-lock.json
CLAUDE.md
HANDOFF.md
reports/
